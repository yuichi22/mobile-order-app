APP_BASE_URL=https://haus-qr-order-system.web.app
MAIL_FROM=HAUS POS <no-reply@example.com>
RESEND_API_KEY=your_resend_api_key

# --- Akuto Core 連携(環境依存) ---
# 実値は .env.mobile-order-dev-5f7fd / .env.mobile-order-prod に書く(.env には書かない=全環境に乗るため)
# CORE_SALES_URL=https://asia-northeast1-<core-project>.cloudfunctions.net/receiveSalesEvents
# CORE_SALES_SECRET=<Core の CRM_WEBHOOK_SECRET と同値>
# CORE_ENTITLEMENTS_URL=https://asia-northeast1-<core-project>.cloudfunctions.net/getSpaceEntitlements
# CORE_PROVISION_UPDATE_URL=https://asia-northeast1-<core-project>.cloudfunctions.net/updateSpaceProvision
# CORE_TERMINAL_BASE=https://asia-northeast1-<core-project>.cloudfunctions.net
# PROVISION_BASE_URL=<このアプリの公開URL>

# --- AKUTO 資金繰り連携(環境依存・任意) ---
# 未設定なら発注書・入庫・仕入先を送らない。認証は CORE_SALES_SECRET を使う
# CASHFLOW_FUNCTIONS_URL=https://asia-northeast1-<cashflow-project>.cloudfunctions.net
